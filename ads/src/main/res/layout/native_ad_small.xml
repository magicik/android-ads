<?xml version="1.0" encoding="utf-8"?><!--
    SMALL: compact horizontal row — icon, headline/body (2 lines each), CTA, and an "Ad" badge
    overlaid top-start on the icon. Ported to match color-pop-gp40's adlib_native_small.xml
    pixel-for-pixel. No media/rating — for spots where a full card doesn't fit. No AdChoicesView
    (matching the source design) — AdMob overlays its own default AdChoices icon when the app
    doesn't bind one itself.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/native_ad_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ad_icon"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/native_cta_bg_solid"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/ad_icon"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/ad_call_to_action"
            android:layout_toEndOf="@id/ad_icon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/black"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@android:color/black"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/native_ad_small_badge_bg"
            android:gravity="center"
            android:paddingStart="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="Ad"
            android:textColor="@android:color/white"
            android:textSize="11sp" />
    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
